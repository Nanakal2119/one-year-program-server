# =============================
# SERVER / API
# =============================
PORT=5000
NODE_ENV=production

# REQUIRED: MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/one-year-program?retryWrites=true&w=majority

# REQUIRED in production. Use a long random secret.
JWT_SECRET=replace-with-a-long-random-secret

# Student ID academic year.
ACADEMIC_YEAR=2019

# REQUIRED in production.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password

# Frontend URL(s). Multiple URLs may be comma-separated.
FRONTEND_URL=https://your-portal.vercel.app
FRONTEND_URLS=https://your-registration.vercel.app
